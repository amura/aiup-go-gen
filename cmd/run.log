p[code:import { Component } from '@angular/core';\n\n@Component({\n  selector: 'app-root',\n  template: `<app-navbar></app-navbar>\n    <main class=\"main-content\"><router-outlet></router-outlet></main>\n    <app-footer></app-footer>`,\n  styles: [`\n    .main-content {\n      min-height: calc(100vh - 128px);\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      background: #f9fbfc;\n    }\n  `]\n})\nexport class AppComponent { }\n filename:src/app/app.component.ts language:typescript] map[code:import { Component } from '@angular/core';\n\n@Component({\n  selector: 'app-navbar',\n  template: `\n    <mat-toolbar color=\"primary\" class=\"navbar\">\n      <div class=\"navbar-logo\">\n        <img src=\"assets/logo.png\" alt=\"App Logo\" width=\"36\" height=\"36\" />\n        <span class=\"navbar-title\">MyApp</span>\n      </div>\n      <span class=\"spacer\"></span>\n      <span class=\"navbar-link selected\">Login</span>\n    </mat-toolbar>\n  `,\n  styles: [`\n    .navbar {\n      position: sticky;\n      top: 0;\n      z-index: 99;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.02);\n      padding: 0 32px;\n      min-height: 64px;\n    }\n    .navbar-logo {\n      display: flex;\n      align-items: center;\n    }\n    .navbar-title {\n      font-weight: 700;\n      font-size: 1.3rem;\n      letter-spacing: 2px;\n      margin-left: 15px;\n      color: #ffffff;\n    }\n    .spacer {\n      flex: 1 1 auto;\n    }\n    .navbar-link {\n      font-size: 1rem;\n      font-weight: bold;\n      color: #ffffff;\n      padding: 6px 16px;\n      border-radius: 18px;\n      background: rgba(255,255,255,0.10);\n    }\n    .navbar-link.selected {\n      border-bottom: 2px solid #fff;\n    }\n  `]\n})\nexport class NavbarComponent {} filename:src/app/components/navbar/navbar.component.ts language:typescript] map[code:import { Component } from '@angular/core';\n\n@Component({\n  selector: 'app-footer',\n  template: `\n    <footer class=\"footer\">\n 