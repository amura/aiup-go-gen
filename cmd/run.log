ctor: 'app-login',\n  templateUrl: './login.component.html',\n})\nexport class LoginComponent {\n  loginForm: FormGroup;\n  loading = false;\n\n  constructor(\n    private fb: FormBuilder,\n    private authService: AuthService,\n    private snackBar: MatSnackBar\n  ) {\n    this.loginForm = this.fb.group({\n      username: ['', [Validators.required, Validators.email]],\n      password: ['', [Validators.required, Validators.minLength(8)]],\n    });\n  }\n\n  onSubmit() {\n    if (this.loginForm.invalid) return;\n    this.loading = true;\n    this.authService\n      .login(\n        this.loginForm.get('username')?.value,\n        this.loginForm.get('password')?.value\n      )\n      .subscribe({\n        next: (response) => {\n          this.loading = false;\n          this.snackBar.open('Login successful!', '', { duration: 1500 });\n          // TODO: redirect after login\n        },\n        error: (err) => {\n          this.loading = false;\n          this.snackBar.open('Login failed: ' + (err?.error?.message || 'Unknown error'), '', { duration: 3000 });\n        },\n      });\n  }\n}\n filename:src/app/login/login.component.ts language:typescript] map[code:<mat-card class=\"login-card\">\n  <form [formGroup]=\"loginForm\" (ngSubmit)=\"onSubmit()\" autocomplete=\"off\">\n    <mat-card-title>Login</mat-card-title>\n    <mat-form-field class=\"full-width\">\n      <input matInput placeholder=\"Email\" formControlName=\"username\" type=\"email\" autocapitalize=\"off\" autocomplete=\"username\">\n      <mat-error *ngIf=\"loginForm.get('username')?.hasError('required')\">\n        Email is required\n      </mat-error>\n      <mat-error *ngIf=\"loginForm.get('username')?.hasError('email') && !loginForm.get('username')?.hasError('required')\">\n        Invalid email\n      </mat-error>\n    </mat-form-field>\n    <mat-form-field class=\"full-width\">\n      <input matInput placeholder=\"Password\" formControlName=\"password\" type=\"password\" autocomplete=\"current-password\">\n      <mat-error *ngIf=\"loginForm.get('password')?.hasError('required')\">\n        Password is required\n      </mat-error>\n      <mat-error *ngIf=\"loginForm.get('password')?.hasError('minlength') && !loginForm.get('password')?.hasError('required')\">\n        Minimum 8 characters\n      </mat-error>\n    </mat-form-field>\n    <button mat-raised-button color=\"primary\" type=\"submit\" [disabled]=\"loginForm.invalid || loading\">Login</button>\n  </form>\n</mat-card>\n filename:src/app/login/login.component.html language:html] map[code:import { Injectable } from '@angular/core';\nimport { HttpClient } from '@angular/common/http';\nimport { Observable, of, throwError } from 'rxjs';\nimport { delay, catchError, map } from 'rxjs/operators';\n\n@Injectable({ providedIn: 'root' })\nexport class AuthService {\n  private apiBaseUrl = (window as any)['env']?.API_BASE_URL || '';\n\n  constructor(private http: HttpClient) {}\n\n  login(username: string, password: string): Observable<any> {\n    // Simulate a working login API call, secure and mocked for now\n    // Replace with: return this.http.post(`${this.apiBaseUrl}/login`, { username, password });\n    return of({ result: 'ok', token: 'mock_token' }).pipe(\n      delay(1200),\n      map(value => {\n        if (username === 'user@example.com' && password === 'password123') {\n          return value;\n        } else {\n          throw { status: 401, error: { message: 'Invalid credentials' } };\n        }\n      }),\n      catchError(err => throwError(() => err))\n    );\n  }\n}\n filename:src/app/services/auth.service.ts language:typescript] map[code:.login-card {\n  max-width: 360px;\n  margin: 80px auto;\n  padding: 24px 16px;\n}\n.full-width {\n  width: 100%;\n}\n filename:src/app/login/login.component.css language:css] map[code:export const environment = {\n  production: false,\n  API_BASE_URL: (window as any)[\"env\"]?.API_BASE_URL || '',\n};\n filename:src/environments/environment.ts language:typescript]