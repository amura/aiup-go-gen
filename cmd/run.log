mponent.html',\n  styleUrls: ['./login.component.css']\n})\nexport class LoginComponent {\n  loginForm = this.fb.group({\n    email: ['', [Validators.required, Validators.email]],\n    password: ['', [Validators.required, Validators.minLength(8), Validators.maxLength(32)]]\n  });\n  errorMsg: string = '';\n  loading = false;\n\n  constructor(private fb: FormBuilder, private auth: AuthService, private sanitizer: DomSanitizer) {}\n\n  submit() {\n    this.errorMsg = '';\n    if (!this.loginForm.valid) return;\n    this.loading = true;\n    this.auth.login(this.loginForm.value.email!, this.loginForm.value.password!)\n      .subscribe({\n        next: () => { this.loading = false; alert('Login successful'); },\n        error: (err) => {\n          this.loading = false;\n          this.errorMsg = this.sanitizer.sanitize(1, err.error?.message || 'Login failed.');\n        }\n      });\n  }\n}\n filename:src/app/login/login.component.ts language:typescript] map[code:<mat-card class=\"login-card\">\n  <h2>Sign In</h2>\n  <form [formGroup]=\"loginForm\" (ngSubmit)=\"submit()\">\n    <mat-form-field appearance=\"fill\" class=\"w-100 mb-3\">\n      <mat-label>Email</mat-label>\n      <input matInput formControlName=\"email\" type=\"email\" autocomplete=\"username\" required>\n      <mat-error *ngIf=\"loginForm.get('email')?.invalid && loginForm.get('email')?.touched\">\n        Please enter a valid email address.\n      </mat-error>\n    </mat-form-field>\n    <mat-form-field appearance=\"fill\" class=\"w-100 mb-3\">\n      <mat-label>Password</mat-label>\n      <input matInput formControlName=\"password\" type=\"password\" autocomplete=\"current-password\" required>\n      <mat-error *ngIf=\"loginForm.get('password')?.invalid && loginForm.get('password')?.touched\">\n        Password must be between 8 and 32 characters.\n      </mat-error>\n    </mat-form-field>\n    <div *ngIf=\"errorMsg\" class=\"alert alert-danger\">{{ errorMsg }}</div>\n    <button mat-raised-button color