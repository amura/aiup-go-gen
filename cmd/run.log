r/cli:serve\",\n          \"options\": {\n            \"browserTarget\": \"loginApp:build\"\n          },\n          \"configurations\": {\n            \"production\": {\n              \"browserTarget\": \"loginApp:build:production\"\n            }\n          }\n        }\n      }\n    }\n  },\n  \"defaultProject\": \"loginApp\"\n}\n```\n```typescript\n# filename: src/app/app.component.ts\nimport { Component } from '@angular/core';\n\n@Component({\n  selector: 'app-root',\n  template: `\n    <div>\n      <app-login></app-login>\n    </div>\n  `,\n  styleUrls: ['./app.component.css']\n})\nexport class AppComponent {\n  title = 'loginApp';\n}\n```\n```typescript\n# filename: src/app/login/login.component.ts\nimport { Component } from '@angular/core';\n\n@Component({\n  selector: 'app-login',\n  templateUrl: './login.component.html',\n  styleUrls: ['./login.component.css']\n})\nexport class LoginComponent {\n  login(email: string, password: string): void {\n    console.log(`Login attempt for ${email} with password: ${password}`);\n  }\n}\n```\n```html\n# filename: src/app/login/login.component.html\n<form (submit)=\"login(email.value, password.value)\">\n  <div>\n    <label for=\"email\">Email:</label>\n    <input type=\"email\" id=\"email\" #email required>\n  </div>\n  <div>\n    <label for=\"password\">Password:</label>\n    <input type=\"password\" id=\"password\" #password required>\n  </div>\n  <button type=\"submit\">Log in</button>\n</form>\n```\n```html\n# filename: src/index.html\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>LoginApp</title>\n  <base href=\"/\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\">\n</head>\n<body>\n  <app-root></app-root>\n</body>\n</html>\n```\n```bash\n# filename: install.sh\nnpm install -g @angular/cli\nnpm install\n```\n```bash\n# filename: start.sh\nng serve --open\n```\n\nTo initialize and launch