// File: reasoning_agent.go
package agent

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"log"

	"aiupstart.com/go-gen/internal/llm"
	"aiupstart.com/go-gen/internal/model"
)

// ReasoningAgent is responsible for interpreting LLM output and planning structured follow-ups.
type ReasoningAgent struct {
	llmClient llm.LLMClient
	manager   ChatManager
}

func NewReasoningAgent(llm llm.LLMClient, mgr ChatManager) *ReasoningAgent {
	return &ReasoningAgent{
		llmClient: llm,
		manager:   mgr,
	}
}

func (r *ReasoningAgent) ID() string {
	return "reasoning-agent"
}

func (r *ReasoningAgent) Handle(ctx context.Context, msg *model.AgentMessage) error {
	log.Printf("[ReasoningAgent] Handling message: %s", msg.Content)

	llmResponse, err := r.llmClient.Generate(ctx, msg.Content, true)
	if err != nil {
		return fmt.Errorf("failed to get LLM response: %w", err)
	}

	// Attempt to parse tool call or JSON structured response
	var parsed model.AgentMessage
	err = json.Unmarshal([]byte(llmResponse), &parsed)
	if err == nil && parsed.Type == "tool_call" {
		log.Println("[ReasoningAgent] Parsed tool_call. Forwarding to execution agent.")
		return r.manager.ForwardTo("execution-agent", &parsed)
	}

	// Fallback: try reasoning over plain text and reformulate next tool instruction
	log.Println("[ReasoningAgent] Plain text fallback. Attempting to reformat response into valid tool call.")
	planned := planNextToolCommand(llmResponse)
	if planned == nil {
		return errors.New("reasoning agent could not formulate structured follow-up")
	}

	return r.manager.ForwardTo("execution-agent", planned)
}

// planNextToolCommand is a placeholder logic for transforming plain text back to tool calls
func planNextToolCommand(response string) *model.AgentMessage {
	// TODO: Replace with real logic using regex, heuristics, or even another mini LLM call
	if len(response) < 50 {
		return nil
	}

	return &model.AgentMessage{
		Role:        "reasoning",
		Type:        "tool_call",
		RouteTarget: "toolrunner",
		Content: map[string]interface{}{
			"tool_name": "docker_exec",
			"parameters": map[string]string{
				"script": "launch.sh",
			},
		},
	}
}